{
  "name": "@jarvis/desktop",
  "version": "1.0.0-Preview",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:electron": "playwright test --project=electron",
    "e2e:electron:ci": "electron-vite build && electron-rebuild -f -w better-sqlite3 && playwright test --project=electron",
    "typecheck": "tsc --noEmit",
    "build:daemon": "cd ../../daemon && go build -o ../apps/desktop/resources/daemon/jarvis-daemon ./cmd/jarvis-daemon",
    "build:daemon:win": "cd ../../daemon && GOOS=windows GOARCH=amd64 go build -trimpath -o ../apps/desktop/resources/daemon/jarvis-daemon.exe ./cmd/jarvis-daemon",
    "build:daemon:darwin:x64": "cd ../../daemon && GOOS=darwin GOARCH=amd64 go build -trimpath -o ../apps/desktop/resources/daemon/jarvis-daemon ./cmd/jarvis-daemon",
    "build:daemon:darwin:arm64": "cd ../../daemon && GOOS=darwin GOARCH=arm64 go build -trimpath -o ../apps/desktop/resources/daemon/jarvis-daemon ./cmd/jarvis-daemon",
    "package:win": "electron-builder --win msi --x64",
    "package:mac:x64": "electron-builder --mac dmg --x64",
    "package:mac:arm64": "electron-builder --mac dmg --arm64",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3"
  },
  "dependencies": {
    "@jarvis/core": "workspace:*",
    "@jarvis/i18n": "workspace:*",
    "@jarvis/protocol": "workspace:*",
    "@jarvis/ui": "workspace:*",
    "@tanstack/react-router": "^1.0.0",
    "better-sqlite3": "^11.3.0",
    "i18next": "^23.0.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "react-syntax-highlighter": "^16.1.1",
    "reactflow": "^11.11.4",
    "xlsx": "^0.18.5",
    "yaml": "^2.9.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^32.0.0",
    "electron-vite": "^2.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
